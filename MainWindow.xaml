<Window x:Class="KdrEnet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KdrEnet"
        Title="KDR ENET"
        Width="520"
        Height="520"
        MinWidth="440"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0b0d13"
        Foreground="#f4f7fb"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <local:AlertBrushConverter x:Key="AlertBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C69D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1558b0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f4f7fb"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#2a3344" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161b24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoleButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,0,0,6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="Background" Value="#12161e"/>
            <Setter Property="Foreground" Value="#f4f7fb"/>
            <Setter Property="CaretBrush" Value="#f4f7fb"/>
            <Setter Property="BorderBrush" Value="#3d4d66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8ea0b5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold">
                    <Run Text="KDR" Foreground="#f4f7fb"/>
                    <Run Text=" ENET" Foreground="#1C69D4"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Width="28" Height="3" Background="#2e97d4"/>
                    <Border Width="28" Height="3" Background="#0066b1"/>
                    <Border Width="28" Height="3" Background="#e22718"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Settings" Style="{StaticResource TextButton}" Margin="0,0,16,0" Click="Settings_Click"/>
                <Button Content="About" Style="{StaticResource TextButton}" Click="About_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CarRoleButton" Content="Car laptop" Style="{StaticResource RoleButton}" Margin="0,0,28,0" Click="ChooseCar_Click"/>
            <Button x:Name="EsyRoleButton" Grid.Column="1" Content="E-Sys laptop" Style="{StaticResource RoleButton}" Click="ChooseEsy_Click"/>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusLine}" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,8"
                   Visibility="{Binding IsCarSide, Converter={StaticResource BoolVis}}"/>

        <StackPanel Grid.Row="3" VerticalAlignment="Center">
            <StackPanel Visibility="{Binding IsCarSide, Converter={StaticResource BoolVis}}">
                <TextBlock FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,8">
                    <Run Text="Code"/>
                    <Run Text="  ·  6 digits" Foreground="#5c6b80"/>
                </TextBlock>
                <Border Background="#12161e" BorderBrush="#3d4d66" BorderThickness="1" Padding="14,12" MinHeight="64">
                    <TextBlock Text="{Binding DisplayCode}" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding IsTechSide, Converter={StaticResource BoolVis}}">
                <TextBlock FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,8">
                    <Run Text="Code"/>
                    <Run Text="  ·  6 digits" Foreground="#5c6b80"/>
                </TextBlock>
                <TextBox Style="{StaticResource CodeBox}"
                         Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="6"
                         PreviewTextInput="Code_Preview"
                         DataObject.Pasting="Code_Paste"/>
                <TextBlock Margin="0,14,0,8" FontSize="13" Foreground="#8ea0b5" Text="E-Sys address"/>
                <Border Background="#12161e" BorderBrush="#3d4d66" BorderThickness="1" Padding="14,10">
                    <TextBlock Text="127.0.0.1" FontSize="22" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,14">
            <Button Content="{Binding StartLabel}" Style="{StaticResource PrimaryButton}" MinWidth="108" Margin="0,0,8,0" Click="Start_Click" IsEnabled="{Binding CanStart}"
                    Visibility="{Binding IsCarSide, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding JoinLabel}" Style="{StaticResource PrimaryButton}" MinWidth="108" Margin="0,0,8,0" Click="Join_Click" IsEnabled="{Binding CanJoin}"
                    Visibility="{Binding IsTechSide, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding CopyLabel}" Style="{StaticResource GhostButton}" MinWidth="108" Margin="0,0,8,0" Click="Copy_Click" IsEnabled="{Binding CanCopy}"
                    Visibility="{Binding ShowCopy, Converter={StaticResource BoolVis}}"/>
            <Button Content="Stop" Style="{StaticResource GhostButton}" MinWidth="72" Click="Stop_Click"
                    Visibility="{Binding CanStop, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="{Binding NextDetail}" FontSize="13" Foreground="#b7c3d1" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastLine}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#e8b15a"
                       Visibility="{Binding LastLineAlert, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </Grid>
</Window>
