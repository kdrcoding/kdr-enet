<Window x:Class="KdrEnet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KdrEnet"
        Title="KDR ENET"
        Width="520"
        Height="820"
        MinWidth="440"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0b0d13"
        Foreground="#f4f7fb"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <local:AlertBrushConverter x:Key="AlertBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C69D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1558b0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f4f7fb"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#2a3344" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161b24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#12161e"/>
            <Setter Property="Foreground" Value="#d5deea"/>
            <Setter Property="BorderBrush" Value="#3d4d66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1C69D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoleButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,0,0,6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DigitBox" TargetType="TextBox">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="MaxLength" Value="1"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#12161e"/>
            <Setter Property="Foreground" Value="#f4f7fb"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="SelectionBrush" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3d4d66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ContextMenu" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1C69D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DigitRead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#8ea0b5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CodeReady}" Value="True">
                    <Setter Property="Foreground" Value="#f4f7fb"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8ea0b5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold">
                    <Run Text="KDR" Foreground="#f4f7fb"/>
                    <Run Text=" ENET" Foreground="#1C69D4"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Width="28" Height="3" Background="#2e97d4"/>
                    <Border Width="28" Height="3" Background="#0066b1"/>
                    <Border Width="28" Height="3" Background="#e22718"/>
                </StackPanel>
                <TextBlock Text="{Binding PingText}" FontSize="13" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8ea0b5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PingTone}" Value="good">
                                    <Setter Property="Foreground" Value="#f4f7fb"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PingTone}" Value="wrong">
                                    <Setter Property="Foreground" Value="#e8b15a"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="The server is far. Open Radmin VPN on both laptops, join the same network, then Start on the car laptop."
                           FontSize="13" Foreground="#e8b15a" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding PingIsFar, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Settings" Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" Click="Settings_Click"/>
                <Button Content="About" Style="{StaticResource ChoiceButton}" Click="About_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="1. How the two laptops connect" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,6"/>
            <UniformGrid Columns="2">
                <Button x:Name="KdrPathButton" Content="KDR server" Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" Click="ChooseKdr_Click"/>
                <Button x:Name="RadminPathButton" Content="Radmin VPN" Style="{StaticResource ChoiceButton}" Click="ChooseRadmin_Click"/>
            </UniformGrid>
        </StackPanel>

        <Button Grid.Row="2" Content="Open Radmin VPN" Style="{StaticResource ChoiceButton}" HorizontalAlignment="Stretch" Margin="0,0,0,14" Click="Radmin_Click"/>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="2. Which laptop is this" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,6"/>
            <UniformGrid Columns="2">
                <Button x:Name="CarRoleButton" Content="Car laptop" Style="{StaticResource ChoiceButton}" Margin="0,0,8,0" Click="ChooseCar_Click"/>
                <Button x:Name="EsyRoleButton" Content="E-Sys laptop" Style="{StaticResource ChoiceButton}" Click="ChooseEsy_Click"/>
            </UniformGrid>
            <TextBlock Text="{Binding GuideLine}" FontSize="14" Foreground="#f4f7fb" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusLine}" FontSize="13" Foreground="#8ea0b5"
                       Visibility="{Binding IsCarSide, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding VinLine}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"
                       Visibility="{Binding ShowVin, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding CarFactsLine}" FontSize="14" Foreground="#d5deea" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding ShowCarFacts, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" VerticalAlignment="Center">
            <StackPanel Visibility="{Binding ShowCarCode, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Read these 6 numbers out loud" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Shown0}" Style="{StaticResource DigitRead}"/>
                    <TextBlock Text="{Binding Shown1}" Style="{StaticResource DigitRead}"/>
                    <TextBlock Text="{Binding Shown2}" Style="{StaticResource DigitRead}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding Shown3}" Style="{StaticResource DigitRead}"/>
                    <TextBlock Text="{Binding Shown4}" Style="{StaticResource DigitRead}"/>
                    <TextBlock Text="{Binding Shown5}" Style="{StaticResource DigitRead}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowCarRadmin, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Address for the other laptop" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding RadminReadout}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowTechCode, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Type the 6 numbers from the car laptop" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="Digit0" Style="{StaticResource DigitBox}"/>
                    <TextBox x:Name="Digit1" Style="{StaticResource DigitBox}"/>
                    <TextBox x:Name="Digit2" Style="{StaticResource DigitBox}" Margin="0,0,18,0"/>
                    <TextBox x:Name="Digit3" Style="{StaticResource DigitBox}"/>
                    <TextBox x:Name="Digit4" Style="{StaticResource DigitBox}"/>
                    <TextBox x:Name="Digit5" Style="{StaticResource DigitBox}" Margin="0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowTechRadmin, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Same Radmin VPN network as the car laptop. In E-Sys, paste the address that laptop shows."
                           FontSize="15" TextWrapping="Wrap" Foreground="#f4f7fb"/>
            </StackPanel>
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{Binding LinkState}" FontSize="22" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8ea0b5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LinkTone}" Value="good">
                                    <Setter Property="Foreground" Value="#f4f7fb"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LinkTone}" Value="wrong">
                                    <Setter Property="Foreground" Value="#e8b15a"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LinkHint}" FontSize="13" Foreground="#8ea0b5" Margin="0,6,0,0"
                           Visibility="{Binding ShowLinkAddress, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding LinkAddress}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"
                           Visibility="{Binding ShowLinkAddress, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,14">
            <Button Content="{Binding StartLabel}" Style="{StaticResource PrimaryButton}" MinWidth="108" Margin="0,0,8,0" Click="Start_Click" IsEnabled="{Binding CanStart}"
                    Visibility="{Binding IsCarSide, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding NewCodeLabel}" Style="{StaticResource GhostButton}" MinWidth="108" Margin="0,0,8,0" Click="NewCode_Click" IsEnabled="{Binding CanNewCode}"
                    Visibility="{Binding ShowCarCode, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding JoinLabel}" Style="{StaticResource PrimaryButton}" MinWidth="108" Margin="0,0,8,0" Click="Join_Click" IsEnabled="{Binding CanJoin}"
                    Visibility="{Binding ShowTechCode, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding CheckLabel}" Style="{StaticResource GhostButton}" MinWidth="120" Margin="0,0,8,0" Click="Check_Click" IsEnabled="{Binding CanCheck}"
                    Visibility="{Binding ShowTechCode, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding CopyLabel}" Style="{StaticResource GhostButton}" MinWidth="108" Margin="0,0,8,0" Click="Copy_Click" IsEnabled="{Binding CanCopy}"
                    Visibility="{Binding ShowCopy, Converter={StaticResource BoolVis}}"/>
            <Button Content="Stop" Style="{StaticResource GhostButton}" MinWidth="72" Click="Stop_Click"
                    Visibility="{Binding CanStop, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="7">
            <TextBlock Text="{Binding CheckWord}" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#b7c3d1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CheckTone}" Value="good">
                                <Setter Property="Foreground" Value="#f4f7fb"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CheckTone}" Value="wrong">
                                <Setter Property="Foreground" Value="#e8b15a"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="Open driver page" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="Driver_Click" Visibility="{Binding ShowDriver, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding LastLine}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#e8b15a"
                       Visibility="{Binding LastLineAlert, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </Grid>
</Window>
