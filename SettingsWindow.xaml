<Window x:Class="KdrEnet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0b0d13"
        Foreground="#f4f7fb"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="Pick" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#12161e"/>
            <Setter Property="Foreground" Value="#d5deea"/>
            <Setter Property="BorderBrush" Value="#3d4d66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#1C69D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f4f7fb"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#2a3344" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Cable" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="EnetButton" Content="ENET" Style="{StaticResource Pick}" Click="Cable_Click" Tag="Enet"/>
                <Button x:Name="KdcanButton" Content="K+DCAN" Style="{StaticResource Pick}" Click="Cable_Click" Tag="Kdcan"/>
                <Button x:Name="IcomButton" Content="ICOM" Style="{StaticResource Pick}" Click="Cable_Click" Tag="Icom"/>
                <Button x:Name="MhdButton" Content="MHD" Style="{StaticResource Pick}" Click="Cable_Click" Tag="Mhd"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock Text="Vehicle" FontSize="13" Foreground="#8ea0b5" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="CarButton" Content="Car" Style="{StaticResource Pick}" Click="Vehicle_Click" Tag="Car"/>
                <Button x:Name="BikeButton" Content="Bike" Style="{StaticResource Pick}" Click="Vehicle_Click" Tag="Bike"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Style="{StaticResource CancelButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource SaveButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
