<Window x:Class="KdrEnet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#05070d"
        Foreground="#f4f7fb"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,18">
            <Run Text="Settings" Foreground="#f4f7fb"/>
        </TextBlock>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Cable" FontSize="12" Foreground="#8ea0b5" Margin="0,0,0,8"/>
            <UniformGrid Columns="2" Rows="2">
                <Button x:Name="EnetButton" Content="ENET" Margin="0,0,8,8" Click="Cable_Click" Tag="Enet"/>
                <Button x:Name="KdcanButton" Content="K+DCAN" Margin="0,0,0,8" Click="Cable_Click" Tag="Kdcan"/>
                <Button x:Name="IcomButton" Content="ICOM" Margin="0,0,8,0" Click="Cable_Click" Tag="Icom"/>
                <Button x:Name="MhdButton" Content="MHD" Click="Cable_Click" Tag="Mhd"/>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="Vehicle" FontSize="12" Foreground="#8ea0b5" Margin="0,0,0,8"/>
            <UniformGrid Columns="2">
                <Button x:Name="CarButton" Content="Car" Margin="0,0,8,0" Click="Vehicle_Click" Tag="Car"/>
                <Button x:Name="BikeButton" Content="Bike" Click="Vehicle_Click" Tag="Bike"/>
            </UniformGrid>
        </StackPanel>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="#8ea0b5" FontSize="13" LineHeight="20"
                   Text="Power on the main window means the module is awake and answering on the cable. It is not a voltmeter. If the module stays quiet with the ignition on, the battery may be too low. A backup of every module is done in E-Sys. This app does not copy that coding data."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Foreground="#f4f7fb">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#243044" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Save" MinWidth="110" Click="Save_Click" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#0096d6" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
