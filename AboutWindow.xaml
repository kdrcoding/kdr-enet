<Window x:Class="KdrEnet.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0b0d13"
        Foreground="#f4f7fb"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#1C69D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#f4f7fb"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#2a3344" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8ea0b5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="18" FontWeight="SemiBold">
                <Run Text="KDR" Foreground="#f4f7fb"/>
                <Run Text=" ENET" Foreground="#1C69D4"/>
            </TextBlock>
            <TextBlock x:Name="VersionLine" Margin="0,6,0,0" Foreground="#8ea0b5" FontSize="13"/>
            <TextBlock x:Name="CreatorLine" Margin="0,4,0,0" FontSize="13" Foreground="#b7c3d1"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="kdrcoding.com" Style="{StaticResource LinkButton}" Click="Site_Click"/>
                <TextBlock Text="  ·  " Foreground="#8ea0b5"/>
                <Button Content="support@kdrcoding.com" Style="{StaticResource LinkButton}" Click="Mail_Click"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#2a3344" BorderThickness="1" Background="#12161e" Padding="10,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TermsBox"
                         IsReadOnly="True"
                         IsUndoEnabled="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#b7c3d1"
                         CaretBrush="#f4f7fb"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         SpellCheck.IsEnabled="False"
                         VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <StackPanel x:Name="ConsentButtons" Orientation="Horizontal">
                <Button Content="Not now" Style="{StaticResource CancelButton}" Margin="0,0,8,0" Click="Decline_Click"/>
                <Button Content="I agree" Style="{StaticResource SaveButton}" Click="Agree_Click"/>
            </StackPanel>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource CancelButton}" Visibility="Collapsed" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
