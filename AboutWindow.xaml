<Window x:Class="KdrEnet.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About KDR ENET"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#05070d"
        Foreground="#f4f7fb"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="20" FontWeight="Bold">
                <Run Text="KDR" Foreground="#f4f7fb"/>
                <Run Text=" ENET" Foreground="#1C69D4"/>
            </TextBlock>
            <TextBlock x:Name="VersionLine" Margin="0,6,0,0" Foreground="#8ea0b5" FontSize="13"/>
            <TextBlock x:Name="CreatorLine" Margin="0,8,0,0" FontSize="14" Text="Created by Kadir"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="kdrcoding.com" Click="Site_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#3ec4f0" Padding="0" FontSize="13"/>
                <TextBlock Text="  ·  " Foreground="#8ea0b5"/>
                <Button Content="support@kdrcoding.com" Click="Mail_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#3ec4f0" Padding="0" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#d5dde6" FontSize="14" LineHeight="22"
                           Text="The laptop with the car shows a 6-digit code. The other laptop types that code. E-Sys uses 127.0.0.1. Nobody installs Radmin."/>
                <TextBlock Margin="0,12,0,16" TextWrapping="Wrap" Foreground="#8ea0b5" FontSize="13" LineHeight="20"
                           Text="Both copies of this app call out to the KDR session server, which joins the matching code. The two laptops can be in different places. Created by Kadir for KDR Coding."/>
                <TextBlock Text="Terms" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="TermsBox"
                         IsReadOnly="True"
                         IsUndoEnabled="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#b7c3d1"
                         CaretBrush="#f4f7fb"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         SpellCheck.IsEnabled="False"
                         VerticalScrollBarVisibility="Disabled"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel x:Name="ConsentButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Not now" MinWidth="100" Margin="0,0,8,0" Click="Decline_Click" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Foreground="#f4f7fb">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="#243044" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="I agree" MinWidth="110" Click="Agree_Click" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#0096d6" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right" MinWidth="110" Visibility="Collapsed" Click="Close_Click" Padding="16,10" Cursor="Hand" FontWeight="SemiBold" Foreground="#f4f7fb">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#243044" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
